# Gemini (cloud) — currently unused by the UI, kept for future re-enabling
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local) — the only model exposed in the demo UI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# App
DEFAULT_PROVIDER=ollama
CORS_ORIGINS=*

# Set this before exposing the app to an audience so only you can upload or
# delete documents (send it as the X-Admin-Token header). Leave blank locally.
ADMIN_TOKEN=
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
